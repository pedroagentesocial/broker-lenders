---
// Carousel Rates component
import {
  getRatesData,
  getRatesHistory,
  getSeries,
  getRateChange,
  getSeriesStats,
  buildSparklinePath
} from '../utils/ratesData';
import en from "../translations/carousel-rates/en.json";
import es from "../translations/carousel-rates/es.json";
const enB64 = Buffer.from(JSON.stringify(en)).toString('base64');
const esB64 = Buffer.from(JSON.stringify(es)).toString('base64');

const STATE = 'utah';
const SPARK_W = 128;
const SPARK_H = 40;
const SPARK_DAYS = 30;

type RateValues = { rate?: string };

const ratesData = await getRatesData();
const history = await getRatesHistory();
const utahRates: Record<string, RateValues | undefined> = ratesData[STATE] || {};

// Productos que se muestran en el carrusel
const PRODUCTS = [
  { key: '30-year-fixed', i18n: '30_year_fixed', label: '30-year fixed' },
  { key: '30-year-usda', i18n: '30_year_usda', label: '30-year USDA' },
  { key: '15-year-fixed', i18n: '15_year_fixed', label: '15-year fixed' },
  { key: '30-year-fha', i18n: '30_year_fha', label: '30-year FHA' },
  { key: '30-year-va', i18n: '30_year_va', label: '30-year VA' },
  { key: '30-year-jumbo', i18n: '30_year_jumbo', label: '30-year Jumbo' }
];

const asPercent = (value: string | number | null | undefined) => {
  if (value === undefined || value === null) return '—';
  const text = String(value).trim();
  return text.endsWith('%') ? text : `${text}%`;
};

// Paleta por dirección: la tasa sube = rojo (peor para el cliente), baja = verde
const TREND = {
  up: { stroke: '#dc2626', fill: 'rgba(220, 38, 38, 0.14)', chip: 'chip-up', arrow: 'M6 2.5 L10 8 L2 8 Z' },
  down: { stroke: '#15803d', fill: 'rgba(21, 128, 61, 0.14)', chip: 'chip-down', arrow: 'M6 9.5 L2 4 L10 4 Z' },
  flat: { stroke: '#475569', fill: 'rgba(71, 85, 105, 0.12)', chip: 'chip-flat', arrow: 'M2 6 L10 6' }
};

const cards = PRODUCTS.map((product) => {
  const values = utahRates[product.key];
  if (!values) return null;

  const series = getSeries(history, STATE, product.key, SPARK_DAYS);
  const change = getRateChange(series, 7);
  const stats = getSeriesStats(series);
  const spark = buildSparklinePath(series, SPARK_W, SPARK_H, 4);
  // getRateChange vive en un .js sin tipos, así que su `direction` llega como string
  const direction = (change?.direction || 'flat') as keyof typeof TREND;

  return {
    ...product,
    rate: asPercent(values.rate),
    change,
    stats,
    direction,
    trend: TREND[direction],
    // Path del área bajo la curva, cerrado contra la base del viewBox
    areaPath: spark ? `${spark.d} L ${SPARK_W} ${SPARK_H} L 0 ${SPARK_H} Z` : null,
    linePath: spark ? spark.d : null,
    lastPoint: spark ? spark.points[spark.points.length - 1] : null,
    daysTracked: series.length
  };
}).filter((card) => card !== null);

const hasHistory = history.length > 0;
---

<section class="py-8 bg-white">
  <div class="w-full max-w-none">
    <!-- Header with title and button (padded and centered) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900" data-i18n="stay_updated_title">Stay updated on today’s rates</h2>
        <a
          href="/rates"
          class="bg-gray-100 border border-gray-300 text-gray-700 px-4 py-2 rounded-full text-sm font-medium hover:bg-gray-200 transition-colors"
          data-i18n="see_all_rates"
        >
          See all rates
        </a>
      </div>
    </div>

    <!-- Carousel container -->
    <div class="carousel-container overflow-hidden">
      <div class="carousel-track" data-basecount={cards.length}>
        {cards.map((card) => (
          <article class="rate-item">
            <!-- Producto + variación semanal -->
            <div class="flex items-start justify-between gap-2 mb-3">
              <h3 class="rate-label" data-i18n={card.i18n}>{card.label}</h3>
              {card.change ? (
                <span class={`rate-chip ${card.trend.chip}`}>
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                    {card.direction === 'flat'
                      ? <path d={card.trend.arrow} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
                      : <path d={card.trend.arrow} fill="currentColor" />}
                  </svg>
                  <span>{card.change.sign}{card.change.value}%</span>
                </span>
              ) : (
                <span class="rate-chip chip-flat" data-i18n="building_history">Building history</span>
              )}
            </div>

            <!-- Tasa + sparkline -->
            <div class="flex items-end justify-between gap-3 mb-3">
              <div class="min-w-0">
                <div class="rate-value">{card.rate}</div>
                <div class="rate-caption" data-i18n="vs_last_week">vs. last week</div>
              </div>

              {card.linePath && card.lastPoint ? (
                <svg
                  class="rate-spark"
                  viewBox={`0 0 ${SPARK_W} ${SPARK_H}`}
                  width={SPARK_W}
                  height={SPARK_H}
                  preserveAspectRatio="none"
                  role="img"
                  aria-label={`${card.label} trend, last ${card.daysTracked} days`}
                >
                  <path d={card.areaPath} fill={card.trend.fill} />
                  <path
                    d={card.linePath}
                    fill="none"
                    stroke={card.trend.stroke}
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    vector-effect="non-scaling-stroke"
                  />
                  <circle cx={card.lastPoint[0]} cy={card.lastPoint[1]} r="2.6" fill={card.trend.stroke} />
                </svg>
              ) : (
                <div class="rate-spark rate-spark-empty" aria-hidden="true"></div>
              )}
            </div>

            <!-- Rango del periodo con marcador de la tasa actual -->
            {card.stats && card.stats.max > card.stats.min && (
              <div class="mb-3">
                <div class="rate-range">
                  <span class="rate-range-marker" style={`left: ${(card.stats.position * 100).toFixed(1)}%; background:${card.trend.stroke}`}></span>
                </div>
                <div class="flex justify-between mt-1">
                  <span class="rate-range-label">{card.stats.min.toFixed(3)}%</span>
                  <span class="rate-range-label" data-i18n="last_30_days">Last 30 days</span>
                  <span class="rate-range-label">{card.stats.max.toFixed(3)}%</span>
                </div>
              </div>
            )}

            <!-- Periodo de la tendencia -->
            <div class="rate-footer">
              <span class="rate-meta-label" data-i18n="index_average">Index average</span>
              <span class="rate-meta-label">{card.daysTracked} d</span>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
      <div class="flex justify-between items-center text-xs gap-4">
        <p class="text-gray-500">
          <span data-i18n="rates_current_as_of">Rates are current as of</span> <strong>{ratesData.asOf}</strong>.
          <span data-i18n="source_label">Source:</span>
          <a href={ratesData.source.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-gray-700">{ratesData.source.name}</a>
          <span class="hidden sm:inline"> · {ratesData.source.via}</span>
          <br />
          <span data-i18n="national_average_note">National average. Not a quote: your rate depends on loan amount, LTV, term and credit profile.</span>
        </p>
        <button id="openModal" class="text-gray-600 hover:text-gray-800 underline cursor-pointer whitespace-nowrap" data-i18n="view_legal_disclosures">View legal disclosures</button>
      </div>
    </div>
  </div>

  <!-- Modal -->
  <div id="modal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 max-w-2xl mx-4 max-h-[80vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold" data-i18n="legal_disclosures_title">Legal Disclosures</h3>
        <button id="closeModal" class="text-gray-500 hover:text-gray-700 text-2xl font-bold">&times;</button>
      </div>
      <div class="text-sm text-gray-700 space-y-4">
        <p data-i18n="legal_disclosures_text">
          The Broker Lenders purchase rates are for estimation purposes only. Every situation is different. Results do not reflect all loan programs and are subject to individual program loan limits. Qualification, rates and payments will vary based on timing and individual circumstances. Mortgage rates and pricing could change daily. Actual payments will vary based on your individual situation and current rates. Some products may not be available in all states. Some jumbo products may not be available to first time home buyers. Lending services may not be available in all areas. Some restrictions may apply. This is not a commitment to lend.
        </p>

        <div class="space-y-3">
          <p>
            <strong data-i18n="30_year_fixed_example">30-year Fixed-Rate Loan:</strong> <span data-i18n="30_year_fixed_example_text">An interest rate of 6.375% (6.663% APR) is for the cost of 2.00 point(s) ($7,000.00) paid at closing. On a $350,000 mortgage, you would make monthly payments of $2,183.55. Monthly payment does not include taxes and insurance premiums. The actual payment amount will be greater. Payment assumes a loan-to-value (LTV) of 80.00%.</span>
          </p>

          <p>
            <strong data-i18n="30_year_va_example">30-year Fixed-Rate VA Loan:</strong> <span data-i18n="30_year_va_example_text">An interest rate of 5.99% (6.372% APR) is for a cost of 1.75 Point(s) ($6,125.00) paid at closing. On a $350,000 mortgage, you would make monthly payments of $2,096.18. Monthly payment does not include taxes and insurance premiums. The actual payment amount will be greater. Payment assumes a loan-to-value (LTV) of 80.00%.</span>
          </p>

          <p data-i18n="va_loans_note">
            VA loans do not require PMI. The VA loan is a benefit of military service and only offered to veterans, surviving spouses and active duty military.
          </p>

          <p>
            <strong data-i18n="30_year_jumbo_example">30-year Fixed-Rate Loan (Jumbo):</strong> <span data-i18n="30_year_jumbo_example_text">An interest rate of 5.625% (5.829% APR) is for the cost of 1.75 point(s) ($19,250.00) paid at closing. On a $1,100,000 mortgage, you would make monthly payments of $6,332.23. Monthly payment does not include taxes and insurance premiums. The actual payment amount will be greater. Payment assumes a loan-to-value (LTV) of 70.00%.</span>
          </p>

          <p class="text-xs text-gray-500" data-i18n="chart_disclosure">
            The trend charts show the daily rates published on this site over the last 30 days. They are historical estimates for illustration only and are not a quote, an index, or a forecast.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .carousel-container {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* Degradados laterales para que las tarjetas entren y salgan suavemente */
  .carousel-container::before,
  .carousel-container::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3rem;
    z-index: 2;
    pointer-events: none;
  }
  .carousel-container::before {
    left: 0;
    background: linear-gradient(to right, #fff, rgba(255, 255, 255, 0));
  }
  .carousel-container::after {
    right: 0;
    background: linear-gradient(to left, #fff, rgba(255, 255, 255, 0));
  }

  .carousel-track {
    display: flex;
    gap: 1rem;
    padding: 0.25rem 1rem;
    width: max-content;
    animation: scroll 60s linear infinite;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  /* Tarjeta */
  .rate-item {
    flex: 0 0 320px;
    min-width: 320px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.875rem;
    padding: 1rem 1.125rem 1.125rem;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 8px 20px -12px rgba(15, 23, 42, 0.18);
    transition: box-shadow 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .rate-item:hover {
    border-color: #cbd5e1;
    transform: translateY(-2px);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 16px 28px -16px rgba(15, 23, 42, 0.28);
  }

  .rate-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #475569;
    margin: 0;
  }

  .rate-value {
    font-size: 1.75rem;
    line-height: 1.1;
    font-weight: 700;
    color: #0f172a;
    font-variant-numeric: tabular-nums;
  }

  .rate-caption {
    font-size: 0.6875rem;
    color: #94a3b8;
    margin-top: 0.125rem;
  }

  /* Chip de variación */
  .rate-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
    padding: 0.1875rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    border: 1px solid transparent;
  }
  .chip-up {
    color: #b91c1c;
    background: #fef2f2;
    border-color: #fecaca;
  }
  .chip-down {
    color: #15803d;
    background: #f0fdf4;
    border-color: #bbf7d0;
  }
  .chip-flat {
    color: #475569;
    background: #f1f5f9;
    border-color: #e2e8f0;
  }

  /* Sparkline */
  .rate-spark {
    flex-shrink: 0;
    width: 128px;
    height: 40px;
    overflow: visible;
  }
  .rate-spark-empty {
    border-bottom: 2px dashed #e2e8f0;
    height: 40px;
  }

  /* Barra de rango del periodo */
  .rate-range {
    position: relative;
    height: 6px;
    border-radius: 9999px;
    background: linear-gradient(to right, #dcfce7, #e2e8f0, #fee2e2);
  }

  .rate-range-marker {
    position: absolute;
    top: 50%;
    width: 3px;
    height: 12px;
    border-radius: 9999px;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 2px #fff;
  }

  .rate-range-label {
    font-size: 0.625rem;
    color: #94a3b8;
    font-variant-numeric: tabular-nums;
  }

  /* Pie con APR y puntos */
  .rate-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 0.75rem;
    border-top: 1px solid #f1f5f9;
  }

  .rate-meta-label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #94a3b8;
    margin-bottom: 0.125rem;
  }

  .rate-meta-value {
    font-size: 0.875rem;
    font-weight: 700;
    color: #0f172a;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .rate-item {
      flex: 0 0 280px;
      min-width: 280px;
    }
    .carousel-track {
      animation-duration: 40s;
    }
    .carousel-container::before,
    .carousel-container::after {
      width: 1.5rem;
    }
  }

  /* Desplaza exactamente el ancho de un set base (lo calcula el script) */
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--scroll-distance, 50%)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      animation: none;
    }
    .carousel-container {
      overflow-x: auto;
    }
    .rate-item:hover {
      transform: none;
    }
  }
</style>

<!-- Inline i18n payloads encoded -->
<div id="i18n-carousel" data-en={enB64} data-es={esB64} style="display:none"></div>

<script is:inline>
  (function(){
  // Modal functionality
  const modal = document.getElementById('modal');
  const openModalBtn = document.getElementById('openModal');
  const closeModalBtn = document.getElementById('closeModal');

  openModalBtn?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  });

  closeModalBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  });

  // Close modal when clicking outside
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }
  });

  // i18n for CarouselRates
  const i18nEl = document.getElementById('i18n-carousel');
  const decode = (val) => {
    try {
      const b64 = val || '';
      const bin = atob(b64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const jsonText = new TextDecoder('utf-8').decode(bytes);
      return JSON.parse(jsonText);
    } catch { return {}; }
  };
  const translations = {
    en: decode(i18nEl?.getAttribute('data-en') || ''),
    es: decode(i18nEl?.getAttribute('data-es') || ''),
  };
  const getInitialLang = () => {
    const urlLang = new URLSearchParams(window.location.search).get('lang');
    const stored = localStorage.getItem('lang');
    return (urlLang || stored || 'en');
  };
  const applyTranslations = (lang) => {
    const dict = translations[lang] || translations.en;
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key]) el.textContent = dict[key];
    });
  };
  const formatDateForLang = (lang) => {
    const span = document.getElementById('rates-date');
    if (!span) return;
    const tsAttr = span.getAttribute('data-ts');
    let d;
    if (tsAttr) {
      // Try numeric (epoch ms), else parse ISO/date string
      const num = Number(tsAttr);
      if (!Number.isNaN(num) && isFinite(num)) {
        d = new Date(num);
      } else {
        const parsed = new Date(tsAttr);
        d = isNaN(parsed.getTime()) ? new Date() : parsed;
      }
    } else {
      d = new Date();
    }
    const locale = lang === 'es' ? 'es-ES' : 'en-US';
    const text = d.toLocaleString(locale, {
      timeZone: 'America/Denver',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZoneName: 'short'
    });
    span.textContent = text;
  };
  const setLanguage = (lang) => {
    applyTranslations(lang);
    formatDateForLang(lang);
  };
  // Initialize
  setLanguage(getInitialLang());
  // React to language menu clicks handled globally in Header
  document.addEventListener('click', (e) => {
    const a = e.target.closest('a[href*="?lang="]');
    if (a) {
      const href = new URL(a.href);
      const lang = href.searchParams.get('lang');
      if (lang) setLanguage(lang);
    }
  });

  // Loop infinito: clonamos el set base y desplazamos exactamente su ancho
  const container = document.querySelector('.carousel-container');
  const track = container ? container.querySelector('.carousel-track') : null;
  if (container && track) {
    const setupCarousel = () => {
      const baseCountAttr = track.getAttribute('data-basecount');
      const baseCount = baseCountAttr
        ? Number(baseCountAttr)
        : track.querySelectorAll('.rate-item').length;
      if (!baseCount) return;

      const baseChildren = Array.from(track.children).slice(0, baseCount);

      // Al menos una copia para poder medir el salto del loop, y las que hagan
      // falta para cubrir el doble del ancho visible.
      const target = container.offsetWidth * 2;
      let guard = 0;
      do {
        for (const node of baseChildren) track.appendChild(node.cloneNode(true));
        guard++;
      } while (track.scrollWidth < target && guard < 10);

      // Distancia = posición del primer item del segundo set (incluye el gap)
      const items = track.children;
      const first = items[0];
      const firstOfSecondSet = items[baseCount];
      if (!first || !firstOfSecondSet) return;

      const distance = firstOfSecondSet.getBoundingClientRect().left
        - first.getBoundingClientRect().left;
      if (distance > 0) {
        track.style.setProperty('--scroll-distance', `${distance}px`);
      }
    };

    setupCarousel();

    // Recalcular si cambia el ancho (rotación de pantalla, resize)
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const baseCount = Number(track.getAttribute('data-basecount')) || 0;
        const items = track.children;
        if (!baseCount || !items[baseCount]) return;
        const distance = items[baseCount].getBoundingClientRect().left
          - items[0].getBoundingClientRect().left;
        if (distance > 0) track.style.setProperty('--scroll-distance', `${distance}px`);
      }, 200);
    });
  }
  })();
</script>
