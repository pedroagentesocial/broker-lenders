---
import enPage from '../../translations/realtors/en.json';
const dict = enPage as any;
---

<div
  class="mobile-floating-cta fixed inset-x-0 bottom-0 z-50 lg:hidden"
  data-state="hidden"
  aria-hidden="true"
  inert
  role="region"
  aria-label={dict.mobileCTA.regionLabel}
  data-i18n-aria="mobileCTA.regionLabel"
>
  <div
    class="bg-white shadow-[0_-4px_20px_rgba(0,0,0,0.08)]"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
  >
    <div class="flex items-stretch gap-3 px-4 pt-3">
      <a
        id="realtor-mobile-cta-book"
        href="/booking?lang=en"
        aria-label={dict.mobileCTA.primaryAria}
        data-i18n-aria="mobileCTA.primaryAria"
        class="mfc-primary inline-flex flex-[65] items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-3 min-h-[48px] text-base font-bold text-white transition-transform duration-100 ease-out hover:bg-red-500 active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2"
      >
        <svg
          class="h-4 w-4 flex-shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="4" rx="2" />
          <line x1="16" x2="16" y1="2" y2="6" />
          <line x1="8" x2="8" y1="2" y2="6" />
          <line x1="3" x2="21" y1="10" y2="10" />
        </svg>
        <span data-i18n="mobileCTA.primary">{dict.mobileCTA.primary}</span>
      </a>
      <a
        href="tel:+18013070273"
        aria-label={dict.mobileCTA.secondaryAria}
        data-i18n-aria="mobileCTA.secondaryAria"
        class="mfc-secondary inline-flex flex-[35] items-center justify-center rounded-xl border-2 border-gray-300 bg-white px-4 py-3 min-h-[48px] text-gray-900 transition-transform duration-100 ease-out hover:bg-gray-50 active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2"
      >
        <svg
          class="h-5 w-5 flex-shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  /*
   * Slide-up + fade entry/exit. Default state: off-screen below + invisible.
   * When [data-state="visible"]: in position + visible.
   */
  .mobile-floating-cta {
    transform: translateY(100%);
    opacity: 0;
    transition: transform 250ms ease-out, opacity 250ms ease-out;
    pointer-events: none;
  }
  .mobile-floating-cta[data-state="visible"] {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  /* Reduced motion: opacity-only transition, no slide. */
  @media (prefers-reduced-motion: reduce) {
    .mobile-floating-cta,
    .mobile-floating-cta[data-state="visible"] {
      transform: none;
      transition: opacity 200ms ease-out;
    }
  }
</style>

<style is:global>
  /*
   * Reserve bottom space on mobile so the floating bar (~88px including
   * safe-area on notched devices) never covers content. Scoped via
   * <body data-realtors-floating> so this only applies on the realtors page.
   */
  @media (max-width: 1023px) {
    body[data-realtors-floating="true"] {
      padding-bottom: calc(88px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>

<script is:inline>
  (() => {
    const init = () => {
      const bar = document.querySelector('.mobile-floating-cta');
      if (!bar) return;

      // Mark body so the global media query reserves bottom padding on mobile.
      document.body.setAttribute('data-realtors-floating', 'true');

      const heroEl     = document.querySelector('.realtors-hero-section');
      const finalCtaEl = document.querySelector('.finalcta-section');
      const footerEl   = document.querySelector('#footer');

      // No IntersectionObserver support: just show always (mobile already filtered via Tailwind lg:hidden).
      if (!('IntersectionObserver' in window)) {
        bar.setAttribute('data-state', 'visible');
        bar.setAttribute('aria-hidden', 'false');
        bar.removeAttribute('inert');
        return;
      }

      let pastHero = !heroEl;       // if hero missing, treat as already past
      let inFinalCTA = false;
      let inFooterArea = false;

      const update = () => {
        const shouldShow = pastHero && !inFinalCTA && !inFooterArea;
        bar.setAttribute('data-state', shouldShow ? 'visible' : 'hidden');
        bar.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
        if (shouldShow) {
          bar.removeAttribute('inert');
        } else {
          bar.setAttribute('inert', '');
        }
      };

      if (heroEl) {
        new IntersectionObserver(([entry]) => {
          pastHero = !entry.isIntersecting;
          update();
        }, { threshold: 0 }).observe(heroEl);
      }

      if (finalCtaEl) {
        new IntersectionObserver(([entry]) => {
          inFinalCTA = entry.isIntersecting;
          update();
        }, { threshold: 0 }).observe(finalCtaEl);
      }

      if (footerEl) {
        new IntersectionObserver(([entry]) => {
          inFooterArea = entry.isIntersecting;
          update();
        }, { threshold: 0 }).observe(footerEl);
      }

      update();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
