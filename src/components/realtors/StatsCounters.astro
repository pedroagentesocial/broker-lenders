---
import enPage from '../../translations/realtors/en.json';
const dict = enPage as any;

interface StatConfig {
  id: string;
  value: number;
  digits: number;
}

const stats: StatConfig[] = [
  { id: 'closing',     value: 14,  digits: 2 },
  { id: 'preapproval', value: 24,  digits: 2 },
  { id: 'states',      value: 7,   digits: 1 },
  { id: 'bilingual',   value: 100, digits: 3 },
];
---

<section
  class="stats-section relative overflow-hidden bg-black py-14 lg:py-20"
  aria-labelledby="stats-heading"
>
  <!-- Subtle red-tinted radial glow for depth. Behind content. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(220,38,38,0.10)_0%,transparent_60%)]"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="stats-reveal mb-4 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] text-red-500"
        style="--reveal-delay: 0ms"
        data-i18n="stats.eyebrow"
      >{dict.stats.eyebrow}</p>
      <h2
        id="stats-heading"
        class="stats-reveal mb-5 text-3xl sm:text-4xl lg:text-5xl font-bold text-white"
        style="--reveal-delay: 80ms"
        data-i18n="stats.headline"
      >{dict.stats.headline}</h2>
      <p
        class="stats-reveal mx-auto max-w-2xl text-base sm:text-lg leading-relaxed text-gray-300"
        style="--reveal-delay: 160ms"
        data-i18n="stats.subheadline"
      >{dict.stats.subheadline}</p>
    </div>

    <div class="mt-12 lg:mt-16 grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4 lg:gap-x-8">
      {stats.map((stat, i) => {
        const card = dict.stats.cards[i];
        const hasSuffix = !!(card.suffix && card.suffix.length);
        const isWord = hasSuffix && card.suffixType === 'word';
        return (
          <div
            class={`stats-block stats-reveal flex flex-col items-center text-center ${i > 0 ? 'lg:border-l lg:border-white/10 lg:pl-6 xl:pl-8' : ''}`}
            style={`--reveal-delay: ${320 + i * 100}ms`}
          >
            <div class="mb-3">
              <span class="sr-only" data-i18n={`stats.cards.${i}.ariaText`}>{card.ariaText}</span>
              <span aria-hidden="true" class="inline-flex items-baseline">
                <span
                  class="stat-number inline-block text-right tabular-nums font-bold text-white leading-none text-5xl sm:text-6xl lg:text-7xl"
                  data-stat-target={stat.value}
                  style={`min-width: ${stat.digits}ch`}
                >0</span>
                {hasSuffix && (
                  <span
                    class={`stat-suffix font-bold text-white leading-none ${isWord ? 'ml-2 text-xl sm:text-2xl' : 'text-3xl sm:text-4xl lg:text-5xl'}`}
                    data-i18n={`stats.cards.${i}.suffix`}
                  >{card.suffix}</span>
                )}
              </span>
            </div>
            <p
              class="mb-1 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] text-red-500"
              data-i18n={`stats.cards.${i}.label`}
            >{card.label}</p>
            <p
              class="text-sm text-gray-400"
              data-i18n={`stats.cards.${i}.descriptor`}
            >{card.descriptor}</p>
          </div>
        );
      })}
    </div>

    <p
      class="mt-12 text-center text-xs text-gray-500"
      data-i18n="stats.updatedNote"
    >{dict.stats.updatedNote}</p>
  </div>
</section>

<style>
  /*
   * Reveal: all `.stats-reveal` elements (header items + stat blocks) animate
   * with cascading per-element delay. Counter animation is kicked off in JS
   * ~700ms after section enters view, so blocks finish revealing first.
   */
  .stats-section.reveal-ready .stats-reveal {
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 600ms ease-out var(--reveal-delay, 0ms),
      translate 600ms ease-out var(--reveal-delay, 0ms);
    will-change: opacity, translate;
  }
  .stats-section.reveal-ready.is-visible .stats-reveal {
    opacity: 1;
    translate: 0 0;
  }

  /* Brief glow pulse fired once when each counter finishes. */
  .stat-number.count-done {
    animation: statGlow 700ms ease-out;
  }
  @keyframes statGlow {
    0%   { text-shadow: 0 0 0 transparent; }
    40%  { text-shadow: 0 0 32px rgba(220, 38, 38, 0.45); }
    100% { text-shadow: 0 0 0 transparent; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stats-section.reveal-ready .stats-reveal {
      opacity: 1 !important;
      translate: 0 0 !important;
      transition: none !important;
    }
    .stat-number.count-done {
      animation: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const init = () => {
      const section = document.querySelector('.stats-section');
      if (!section) return;

      const numbers = section.querySelectorAll('.stat-number');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ioSupported = 'IntersectionObserver' in window;

      // Reduced motion or no IO: render final values immediately. No reveal, no count.
      if (reduce || !ioSupported) {
        numbers.forEach((el) => {
          const t = parseInt(el.getAttribute('data-stat-target') || '0', 10);
          el.textContent = String(t);
        });
        return;
      }

      section.classList.add('reveal-ready');

      const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

      const animateCount = (el, target, duration) => {
        const start = performance.now();
        const step = (now) => {
          const elapsed = now - start;
          const t = Math.min(elapsed / duration, 1);
          const value = Math.floor(easeOutCubic(t) * target);
          el.textContent = String(value);
          if (t < 1) {
            requestAnimationFrame(step);
          } else {
            el.textContent = String(target);
            el.classList.add('count-done');
          }
        };
        requestAnimationFrame(step);
      };

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);

            // Counters fire ~700ms after section enters — gives blocks time to reveal.
            setTimeout(() => {
              numbers.forEach((el) => {
                const t = parseInt(el.getAttribute('data-stat-target') || '0', 10);
                animateCount(el, t, 1600);
              });
            }, 700);
          }
        });
      }, { rootMargin: '0px 0px -20% 0px', threshold: 0.01 });

      io.observe(section);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
