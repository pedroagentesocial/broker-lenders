---
import enPage from '../../translations/realtors/en.json';
const dict = enPage as any;

const items = dict.faq.items as Array<{ question: string; answer: string }>;
const lastIndex = items.length - 1;
---

<section
  class="faq-section bg-gray-50 py-16 lg:py-24"
  aria-labelledby="faq-heading"
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p
        class="faq-reveal mb-4 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] text-red-600"
        style="--reveal-delay: 0ms"
        data-i18n="faq.eyebrow"
      >{dict.faq.eyebrow}</p>
      <h2
        id="faq-heading"
        class="faq-reveal mb-5 text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900"
        style="--reveal-delay: 80ms"
        data-i18n="faq.headline"
      >{dict.faq.headline}</h2>
      <p
        class="faq-reveal mx-auto max-w-2xl text-base sm:text-lg leading-relaxed text-gray-600"
        style="--reveal-delay: 160ms"
        data-i18n="faq.subheadline"
      >{dict.faq.subheadline}</p>
    </div>

    <div class="mt-12 lg:mt-16 space-y-3">
      {items.map((item, i) => {
        const isLast = i === lastIndex;
        return (
          <details
            class="faq-item faq-reveal group rounded-xl border border-gray-200 bg-white transition duration-[250ms] ease-out open:border-gray-300 open:shadow-sm"
            style={`--reveal-delay: ${320 + i * 60}ms`}
          >
            <summary
              class="faq-summary flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl px-6 py-5 transition-colors duration-150 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-inset [&::-webkit-details-marker]:hidden"
            >
              <span
                class="text-base lg:text-lg font-semibold text-gray-900"
                data-i18n={`faq.items.${i}.question`}
              >{item.question}</span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5 flex-shrink-0 text-gray-500 transition-transform duration-[250ms] ease-out group-open:rotate-180"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-open:grid-rows-[1fr]">
              <div class="overflow-hidden">
                <div class="px-6 pb-6 pt-1 text-base leading-relaxed text-gray-700">
                  <p data-i18n={`faq.items.${i}.answer`}>{item.answer}</p>
                  {isLast && (
                    <a
                      id="realtor-faq-cta"
                      href="/booking?lang=en"
                      class="mt-4 inline-block rounded-[48px] bg-red-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors duration-200 ease-out hover:bg-red-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2"
                      data-i18n="faq.inlineCta"
                    >{dict.faq.inlineCta}</a>
                  )}
                </div>
              </div>
            </div>
          </details>
        );
      })}
    </div>

    <div
      class="faq-reveal mx-auto mt-12 max-w-2xl rounded-2xl border border-red-600/20 bg-red-600/5 p-6 text-center lg:p-8"
      style="--reveal-delay: 1000ms"
    >
      <div
        class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-600/10 text-red-600"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
      </div>
      <h3
        class="mb-2 text-xl lg:text-2xl font-bold text-gray-900"
        data-i18n="faq.stillHaveQuestions.heading"
      >{dict.faq.stillHaveQuestions.heading}</h3>
      <p
        class="mb-6 text-gray-600"
        data-i18n="faq.stillHaveQuestions.body"
      >{dict.faq.stillHaveQuestions.body}</p>
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="mailto:pedro@brokerlenders.com"
          aria-label={dict.faq.stillHaveQuestions.emailAria}
          data-i18n-aria="faq.stillHaveQuestions.emailAria"
          class="inline-flex items-center justify-center gap-2 rounded-[48px] border-2 border-gray-900 bg-white px-5 py-2.5 text-sm font-semibold text-gray-900 transition-colors duration-200 ease-out hover:bg-gray-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          <span data-i18n="faq.stillHaveQuestions.emailCta">{dict.faq.stillHaveQuestions.emailCta}</span>
        </a>
        <a
          href="tel:+18013070273"
          aria-label={dict.faq.stillHaveQuestions.phoneAria}
          data-i18n-aria="faq.stillHaveQuestions.phoneAria"
          class="inline-flex items-center justify-center gap-2 rounded-[48px] border-2 border-gray-900 bg-white px-5 py-2.5 text-sm font-semibold text-gray-900 transition-colors duration-200 ease-out hover:bg-gray-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <span data-i18n="faq.stillHaveQuestions.phoneCta">{dict.faq.stillHaveQuestions.phoneCta}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Reveal cascade — header items + accordion items + closing card. */
  .faq-section.reveal-ready .faq-reveal {
    opacity: 0;
    translate: 0 12px;
    transition:
      opacity 600ms ease-out var(--reveal-delay, 0ms),
      translate 600ms ease-out var(--reveal-delay, 0ms);
    will-change: opacity, translate;
  }
  .faq-section.reveal-ready.is-visible .faq-reveal {
    opacity: 1;
    translate: 0 0;
  }

  /* Reduced motion: no reveal stagger, snap accordion open/close (no height transition). Chevron rotation can stay — small. */
  @media (prefers-reduced-motion: reduce) {
    .faq-section.reveal-ready .faq-reveal {
      opacity: 1 !important;
      translate: 0 0 !important;
      transition: none !important;
    }
    .faq-panel {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const init = () => {
      const section = document.querySelector('.faq-section');
      if (!section) return;

      // Toggle `inert` on each closed panel so keyboard users never tab into
      // a hidden inline CTA. Native <details> doesn't do this when we override
      // its default hide-on-close with our own grid-rows animation.
      section.querySelectorAll('details.faq-item').forEach((details) => {
        const panel = details.querySelector('.faq-panel');
        if (!panel) return;
        const updateInert = () => {
          if (details.open) {
            panel.removeAttribute('inert');
          } else {
            panel.setAttribute('inert', '');
          }
        };
        updateInert();
        details.addEventListener('toggle', updateInert);
      });

      // Reveal cascade — same pattern as other sections.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ioSupported = 'IntersectionObserver' in window;
      if (reduce || !ioSupported) return;

      section.classList.add('reveal-ready');

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -20% 0px', threshold: 0.01 });

      io.observe(section);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
