---
import enPage from '../../translations/realtors/en.json';
const dict = enPage as any;
---

<section
  class="finalcta-section relative overflow-hidden bg-black py-20 lg:py-28"
  aria-labelledby="finalcta-heading"
>
  <!-- Subtle red-tinted radial overlay for depth (no animation — perf-clean) -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(220,38,38,0.12)_0%,transparent_60%)]"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="fc-reveal mb-5 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] text-red-500"
        style="--reveal-delay: 0ms"
        data-i18n="finalCTA.eyebrow"
      >{dict.finalCTA.eyebrow}</p>

      <h2
        id="finalcta-heading"
        class="fc-reveal-headline mb-6 text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold leading-tight tracking-tight text-white"
        style="--reveal-delay: 100ms"
        data-i18n="finalCTA.headline"
      >{dict.finalCTA.headline}</h2>

      <p
        class="fc-reveal mx-auto mb-10 max-w-2xl text-lg sm:text-xl leading-relaxed text-white/70"
        style="--reveal-delay: 280ms"
        data-i18n="finalCTA.subheadline"
      >{dict.finalCTA.subheadline}</p>

      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          id="realtor-finalcta-book"
          href="/booking?lang=en"
          aria-label={dict.finalCTA.primaryCtaAria}
          data-i18n-aria="finalCTA.primaryCtaAria"
          class="fc-reveal inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-8 py-4 text-lg font-bold text-white shadow-xl transition-all duration-200 ease-out hover:bg-red-500 hover:shadow-2xl hover:scale-[1.02] focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black"
          style="--reveal-delay: 480ms"
        >
          <span data-i18n="finalCTA.primaryCta">{dict.finalCTA.primaryCta}</span>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
        <a
          href="tel:+18013070273"
          aria-label={dict.finalCTA.secondaryCtaAria}
          data-i18n-aria="finalCTA.secondaryCtaAria"
          class="fc-reveal inline-flex items-center justify-center gap-2 rounded-xl border-2 border-white/30 bg-transparent px-8 py-4 text-lg font-bold text-white transition-all duration-200 ease-out hover:bg-white/10 hover:border-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black"
          style="--reveal-delay: 580ms"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span data-i18n="finalCTA.secondaryCta">{dict.finalCTA.secondaryCta}</span>
        </a>
      </div>

      <p
        class="fc-reveal mt-6 text-sm text-white/70"
        style="--reveal-delay: 720ms"
        data-i18n="finalCTA.microcopy"
      >{dict.finalCTA.microcopy}</p>

      <div
        class="fc-reveal mt-4 inline-flex items-center gap-2 text-xs text-white/60"
        style="--reveal-delay: 820ms"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 motion-safe:animate-ping"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
        </span>
        <span data-i18n="finalCTA.responseIndicator">{dict.finalCTA.responseIndicator}</span>
      </div>
    </div>

    <div
      class="fc-reveal mx-auto mt-16 max-w-md border-t border-white/20"
      style="--reveal-delay: 920ms"
      aria-hidden="true"
    ></div>

    <div
      class="fc-reveal mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-white/60"
      style="--reveal-delay: 920ms"
    >
      <span data-i18n="finalCTA.trustNmls">{dict.finalCTA.trustNmls}</span>
      <span class="text-white/30" aria-hidden="true">·</span>
      <span class="inline-flex items-center gap-2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
        <span data-i18n="finalCTA.trustEHL">{dict.finalCTA.trustEHL}</span>
      </span>
      <span class="text-white/30" aria-hidden="true">·</span>
      <span data-i18n="finalCTA.trustStates">{dict.finalCTA.trustStates}</span>
    </div>
  </div>
</section>

<style>
  /*
   * Reveal cascade: most items use 600ms; the headline uses 800ms for extra
   * "weight" on this final moment.
   */
  .finalcta-section.reveal-ready .fc-reveal {
    opacity: 0;
    translate: 0 12px;
    transition:
      opacity 600ms ease-out var(--reveal-delay, 0ms),
      translate 600ms ease-out var(--reveal-delay, 0ms);
    will-change: opacity, translate;
  }
  .finalcta-section.reveal-ready .fc-reveal-headline {
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 800ms ease-out var(--reveal-delay, 0ms),
      translate 800ms ease-out var(--reveal-delay, 0ms);
    will-change: opacity, translate;
  }
  .finalcta-section.reveal-ready.is-visible .fc-reveal,
  .finalcta-section.reveal-ready.is-visible .fc-reveal-headline {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .finalcta-section.reveal-ready .fc-reveal,
    .finalcta-section.reveal-ready .fc-reveal-headline {
      opacity: 1 !important;
      translate: 0 0 !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const init = () => {
      const section = document.querySelector('.finalcta-section');
      if (!section) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ioSupported = 'IntersectionObserver' in window;
      if (reduce || !ioSupported) return;

      section.classList.add('reveal-ready');

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -25% 0px', threshold: 0.01 });

      io.observe(section);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
