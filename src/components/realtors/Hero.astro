---
import { Image } from 'astro:assets';
import heroImg from '../../assets/realtors/hero-realtors.jpg';
import en from '../../translations/realtors/en.json';
const dict = en;
---

<section class="realtors-hero-section relative bg-white overflow-hidden min-h-svh lg:min-h-[85vh]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 py-10 sm:py-14 lg:grid-cols-12 lg:gap-12 lg:py-20 lg:min-h-[85vh] lg:items-center">

      <!-- Text column -->
      <div class="order-1 lg:order-1 lg:col-span-7 flex flex-col justify-center">
        <p
          class="hero-stagger mb-4 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] text-red-600"
          data-i18n="hero.eyebrow"
          style="--stagger:0"
        >{dict.hero.eyebrow}</p>

        <h1 class="hero-stagger mb-5 text-gray-900" style="--stagger:1">
          <span class="hero-rotating relative grid" aria-live="polite" aria-atomic="true">
            {dict.hero.rotating.map((text, i) => (
              <span
                class={`hero-rot-line text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight ${i === 0 ? 'is-active' : ''}`}
                data-rot-index={i}
                data-i18n={`hero.rotating.${i}`}
                aria-hidden={i !== 0 ? 'true' : 'false'}
              >{text}</span>
            ))}
          </span>
        </h1>

        <p
          class="hero-stagger mb-6 max-w-xl text-base sm:text-lg leading-relaxed text-gray-600"
          data-i18n="hero.subheadline"
          style="--stagger:2"
        >{dict.hero.subheadline}</p>

        <div
          class="hero-stagger mb-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-600"
          style="--stagger:3"
        >
          <span class="text-yellow-500 text-base tracking-wider" aria-hidden="true">★★★★★</span>
          <span class="text-gray-300" aria-hidden="true">·</span>
          <span data-i18n="hero.trustBadgeStates">{dict.hero.trustBadgeStates}</span>
          <span class="text-gray-300" aria-hidden="true">·</span>
          <span class="font-semibold text-gray-700" data-i18n="hero.trustBadgeNmls">{dict.hero.trustBadgeNmls}</span>
        </div>

        <div class="hero-stagger flex flex-col gap-3 sm:flex-row" style="--stagger:4">
          <a
            id="realtor-cta-demo"
            href="/booking?lang=en"
            class="inline-flex items-center justify-center rounded-[48px] bg-black px-8 py-3.5 text-base font-semibold text-white transition-colors hover:bg-red-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2"
            data-i18n="hero.primaryCta"
          >{dict.hero.primaryCta}</a>
          <a
            href="tel:+18013070273"
            class="inline-flex items-center justify-center gap-2 rounded-[48px] border-2 border-black bg-white px-8 py-3.5 text-base font-semibold text-black transition-colors hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2"
            aria-label={dict.hero.secondaryCtaAria}
            data-i18n-aria="hero.secondaryCtaAria"
          >
            <svg class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span data-i18n="hero.secondaryCta">{dict.hero.secondaryCta}</span>
          </a>
        </div>

        <p
          class="hero-stagger mt-4 text-xs text-gray-500"
          data-i18n="hero.microcopy"
          style="--stagger:5"
        >{dict.hero.microcopy}</p>
      </div>

      <!-- Visual column -->
      <div class="order-2 lg:order-2 lg:col-span-5 hero-stagger" style="--stagger:2">
        <div class="relative">
          <Image
            src={heroImg}
            alt={dict.hero.imageAlt}
            data-i18n-alt="hero.imageAlt"
            widths={[480, 768, 1024, 1280]}
            sizes="(min-width: 1024px) 480px, 100vw"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="h-[420px] w-full rounded-[36px] object-cover sm:h-[520px] lg:h-[600px] shadow-sm"
          />
          <!-- Floating card -->
          <div class="hero-floating absolute -bottom-4 -left-4 sm:-bottom-6 sm:-left-6 max-w-[260px] rounded-2xl bg-white p-4 shadow-xl ring-1 ring-gray-100">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-green-100" aria-hidden="true">
                <svg class="h-5 w-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <p class="text-sm font-semibold leading-snug text-gray-900" data-i18n="hero.floatingCard">{dict.hero.floatingCard}</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Stack rotating lines in same grid cell so the container sizes to the tallest line — no layout shift on rotation. */
  .hero-rotating > .hero-rot-line {
    grid-area: 1 / 1;
  }

  /* Stagger entrance: 12px slide-up + fade. Delay = stagger index * 80ms + 80ms. */
  .hero-stagger {
    opacity: 0;
    transform: translateY(12px);
    animation: heroStaggerIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--stagger, 0) * 80ms + 80ms);
    will-change: opacity, transform;
  }
  @keyframes heroStaggerIn {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Rotating headline crossfade + slide-up. */
  .hero-rot-line {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 500ms ease, transform 500ms ease;
    pointer-events: none;
  }
  .hero-rot-line.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Floating card gentle bob: -6px to +6px and back, 3s. */
  .hero-floating {
    animation: heroFloat 3s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes heroFloat {
    0%, 100% { transform: translateY(-6px); }
    50%      { transform: translateY(6px); }
  }

  /* Reduced motion: no entrance, no rotation, no bob. First line stays visible. */
  @media (prefers-reduced-motion: reduce) {
    .hero-stagger {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    .hero-rot-line {
      transition: none !important;
    }
    .hero-floating {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const init = () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const lines = Array.from(document.querySelectorAll('.hero-rot-line'));
      if (reduce || lines.length < 2) return;

      let idx = 0;
      const total = lines.length;
      setInterval(() => {
        const prev = lines[idx];
        idx = (idx + 1) % total;
        const next = lines[idx];
        if (prev) {
          prev.classList.remove('is-active');
          prev.setAttribute('aria-hidden', 'true');
        }
        if (next) {
          next.classList.add('is-active');
          next.setAttribute('aria-hidden', 'false');
        }
      }, 4000);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
