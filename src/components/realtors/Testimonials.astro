---
import enPage from '../../translations/realtors/en.json';
const dict = enPage as any;

interface ItemConfig {
  id: number;
  stars: number;
  avatarInitials: string;
  stateEmoji: string;
}

const items: ItemConfig[] = [
  { id: 1, stars: 5, avatarInitials: 'AM', stateEmoji: '🏔️' },
  { id: 2, stars: 5, avatarInitials: 'DR', stateEmoji: '🎰' },
  { id: 3, stars: 5, avatarInitials: 'SC', stateEmoji: '🤠' },
  { id: 4, stars: 5, avatarInitials: 'JT', stateEmoji: '🌲' },
];
---

<section
  class="testimonials-section relative bg-gray-50 py-16 lg:py-24"
  aria-labelledby="testimonials-heading"
>
  <!-- Soft accent blob behind the card for depth -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(220,38,38,0.06)_0%,transparent_55%)]"
  ></div>

  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p
        class="t-reveal mb-4 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] text-red-600"
        style="--reveal-delay: 0ms"
        data-i18n="testimonials.eyebrow"
      >{dict.testimonials.eyebrow}</p>
      <h2
        id="testimonials-heading"
        class="t-reveal mb-5 text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900"
        style="--reveal-delay: 80ms"
        data-i18n="testimonials.headline"
      >{dict.testimonials.headline}</h2>
      <p
        class="t-reveal mx-auto max-w-2xl text-base sm:text-lg leading-relaxed text-gray-600"
        style="--reveal-delay: 160ms"
        data-i18n="testimonials.subheadline"
      >{dict.testimonials.subheadline}</p>
      <div
        class="t-reveal mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-gray-600"
        style="--reveal-delay: 240ms"
      >
        <span class="text-base tracking-wider text-yellow-500" aria-hidden="true">★★★★★</span>
        <span class="text-gray-300" aria-hidden="true">·</span>
        <span data-i18n="testimonials.trustBadge">{dict.testimonials.trustBadge}</span>
      </div>
    </div>

    <div class="t-reveal relative mt-12 lg:mt-16" style="--reveal-delay: 400ms">
      <div class="swiper testimonials-swiper">
        <div class="swiper-wrapper">
          {items.map((item, i) => {
            const t = dict.testimonials.items[i];
            return (
              <div class="swiper-slide">
                <article
                  class="t-card relative grid min-h-[480px] grid-cols-1 gap-6 overflow-hidden rounded-2xl border border-gray-100 bg-white p-8 shadow-2xl transition-shadow duration-300 lg:min-h-[400px] lg:grid-cols-12 lg:gap-12 lg:p-12 hover:shadow-[0_30px_60px_-15px_rgba(0,0,0,0.25)]"
                  aria-labelledby={`tcard-${item.id}-name`}
                >
                  <div class="flex flex-col items-center text-center lg:col-span-4 lg:items-start lg:justify-center lg:text-left">
                    <div
                      class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-red-600/10 text-2xl font-bold text-red-600 lg:h-32 lg:w-32 lg:text-3xl"
                      aria-hidden="true"
                    >{item.avatarInitials}</div>
                    <p
                      id={`tcard-${item.id}-name`}
                      class="text-lg font-bold text-gray-900"
                      data-i18n={`testimonials.items.${i}.name`}
                    >{t.name}</p>
                    <p class="text-sm text-gray-500">
                      <span data-i18n={`testimonials.items.${i}.role`}>{t.role}</span>
                      <span aria-hidden="true"> · </span>
                      <span data-i18n={`testimonials.items.${i}.brokerage`}>{t.brokerage}</span>
                    </p>
                    <p class="mt-1 text-xs text-gray-500">
                      <span data-i18n={`testimonials.items.${i}.location`}>{t.location}</span>
                      <span class="ml-1" aria-hidden="true">{item.stateEmoji}</span>
                    </p>
                    <p class="mt-3 inline-flex items-center gap-1 text-xs text-gray-500">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 flex-shrink-0 text-red-600" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <path d="m9 12 2 2 4-4" />
                      </svg>
                      <span data-i18n="testimonials.verifiedRealtor">{dict.testimonials.verifiedRealtor}</span>
                    </p>
                  </div>

                  <div class="flex flex-col lg:col-span-8">
                    <span aria-hidden="true" class="t-quote-mark font-serif text-7xl leading-none text-red-600 lg:text-8xl">&ldquo;</span>
                    <blockquote
                      class="mt-2 text-xl italic leading-relaxed text-gray-800 lg:text-2xl"
                      data-i18n={`testimonials.items.${i}.body`}
                    >{t.body}</blockquote>
                    <div class="mt-6 flex items-center gap-1">
                      <span class="sr-only" data-i18n="testimonials.starsAria">{dict.testimonials.starsAria}</span>
                      {Array.from({ length: 5 }).map((_, idx) => {
                        const filled = idx < item.stars;
                        return (
                          <svg
                            viewBox="0 0 24 24"
                            fill={filled ? 'currentColor' : 'none'}
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linejoin="round"
                            class={`t-star h-5 w-5 lg:h-6 lg:w-6 ${filled ? 'text-yellow-500' : 'text-gray-300'}`}
                            aria-hidden="true"
                          >
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26" />
                          </svg>
                        );
                      })}
                    </div>
                    <p
                      class="mt-3 text-xs text-gray-400"
                      data-i18n={`testimonials.items.${i}.date`}
                    >{t.date}</p>
                  </div>
                </article>
              </div>
            );
          })}
        </div>
      </div>

      <button
        type="button"
        class="t-prev pointer-events-auto absolute left-2 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-red-600 shadow-md transition-transform duration-200 ease-out hover:scale-105 hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2 lg:-left-4 lg:h-12 lg:w-12"
      >
        <span class="sr-only" data-i18n="testimonials.prevSlide">{dict.testimonials.prevSlide}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>
      <button
        type="button"
        class="t-next pointer-events-auto absolute right-2 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-red-600 shadow-md transition-transform duration-200 ease-out hover:scale-105 hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2 lg:-right-4 lg:h-12 lg:w-12"
      >
        <span class="sr-only" data-i18n="testimonials.nextSlide">{dict.testimonials.nextSlide}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>
    </div>

    <div class="mt-8 flex flex-col items-center gap-3">
      <div class="t-pagination flex items-center justify-center gap-2"></div>
      <p class="t-counter text-xs font-mono tabular-nums text-gray-500" aria-live="polite">
        <span class="t-counter-current">1</span> / <span class="t-counter-total">{items.length}</span>
      </p>
    </div>

    <div class="mt-12 text-center">
      <a
        href="#google-reviews"
        class="group/g inline-flex items-center gap-2 text-sm text-gray-600 transition-colors duration-200 hover:text-red-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2 rounded-sm"
      >
        <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
        </svg>
        <span data-i18n="testimonials.googleReviewsLink">{dict.testimonials.googleReviewsLink}</span>
        <span aria-hidden="true" class="ml-0.5 inline-block transition-transform duration-200 group-hover/g:translate-x-1">→</span>
      </a>
    </div>

    <p class="mt-6 text-center text-xs text-gray-500" data-i18n="testimonials.disclaimer">{dict.testimonials.disclaimer}</p>
  </div>
</section>

<style>
  /* Reveal — header items + carousel container. */
  .testimonials-section.reveal-ready .t-reveal {
    opacity: 0;
    translate: 0 32px;
    transition:
      opacity 600ms ease-out var(--reveal-delay, 0ms),
      translate 600ms ease-out var(--reveal-delay, 0ms);
    will-change: opacity, translate;
  }
  .testimonials-section.reveal-ready.is-visible .t-reveal {
    opacity: 1;
    translate: 0 0;
  }

  /*
   * Quote mark scale-in on each new active slide. Default state = animation
   * start state (hidden) once Swiper has initialized; SSR/no-JS users see
   * the visible final state via the !.swiper-initialized rule below.
   */
  .testimonials-swiper.swiper-initialized .t-quote-mark {
    opacity: 0;
    transform: scale(0.85);
  }
  .testimonials-swiper.swiper-initialized .swiper-slide-active .t-quote-mark {
    animation: tQuoteIn 350ms ease-out forwards;
  }
  @keyframes tQuoteIn {
    from { opacity: 0; transform: scale(0.85); }
    to   { opacity: 0.25; transform: scale(1); }
  }

  /* Star stagger on each new active slide. */
  .testimonials-swiper.swiper-initialized .t-star {
    opacity: 0;
    transform: scale(0.9);
  }
  .testimonials-swiper.swiper-initialized .swiper-slide-active .t-star {
    animation: tStarIn 220ms ease-out forwards;
  }
  .testimonials-swiper.swiper-initialized .swiper-slide-active .t-star:nth-child(2) { animation-delay: 200ms; }
  .testimonials-swiper.swiper-initialized .swiper-slide-active .t-star:nth-child(3) { animation-delay: 250ms; }
  .testimonials-swiper.swiper-initialized .swiper-slide-active .t-star:nth-child(4) { animation-delay: 300ms; }
  .testimonials-swiper.swiper-initialized .swiper-slide-active .t-star:nth-child(5) { animation-delay: 350ms; }
  .testimonials-swiper.swiper-initialized .swiper-slide-active .t-star:nth-child(6) { animation-delay: 400ms; }
  /* Note: nth-child starts at 2 because the first child of the stars row is the sr-only span, not a star. */
  @keyframes tStarIn {
    from { opacity: 0; transform: scale(0.9); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* Custom progress-bar pagination. */
  .t-pagination .swiper-pagination-bullet {
    position: relative;
    width: 32px;
    height: 4px;
    margin: 0 !important;
    border-radius: 9999px;
    background-color: #d1d5db;
    opacity: 1;
    overflow: hidden;
    cursor: pointer;
    border: none;
    transition: background-color 300ms ease;
  }
  .t-pagination .swiper-pagination-bullet:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: 3px;
  }
  .t-bullet-fill {
    position: absolute;
    inset: 0;
    width: 0;
    background-color: #dc2626;
    border-radius: inherit;
  }
  .t-pagination .swiper-pagination-bullet-active .t-bullet-fill {
    animation: tFillBar 7s linear forwards;
  }
  @keyframes tFillBar {
    to { width: 100%; }
  }
  /* Pause progress bar in sync with autoplay (mouse hover, focus, etc.) */
  .testimonials-swiper.is-paused .swiper-pagination-bullet-active .t-bullet-fill {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials-section.reveal-ready .t-reveal {
      opacity: 1 !important;
      translate: 0 0 !important;
      transition: none !important;
    }
    .testimonials-swiper.swiper-initialized .t-quote-mark,
    .testimonials-swiper.swiper-initialized .swiper-slide-active .t-quote-mark {
      opacity: 0.25 !important;
      transform: none !important;
      animation: none !important;
    }
    .testimonials-swiper.swiper-initialized .t-star,
    .testimonials-swiper.swiper-initialized .swiper-slide-active .t-star {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    /* Static accent-color bar on active, no progress fill animation. */
    .t-pagination .swiper-pagination-bullet-active .t-bullet-fill {
      animation: none !important;
      width: 100% !important;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay, EffectFade, Keyboard, A11y } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/effect-fade';

  const init = () => {
    const section = document.querySelector('.testimonials-section');
    if (!section) return;
    const swiperEl = section.querySelector<HTMLElement>('.testimonials-swiper');
    if (!swiperEl) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ioSupported = 'IntersectionObserver' in window;

    if (ioSupported && !reduce) {
      section.classList.add('reveal-ready');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -20% 0px', threshold: 0.01 });
      io.observe(section);
    }

    const counterCurrent = section.querySelector('.t-counter-current');
    const updateCounter = (realIndex: number) => {
      if (counterCurrent) counterCurrent.textContent = String(realIndex + 1);
    };

    const swiper = new Swiper(swiperEl, {
      modules: [Navigation, Pagination, Autoplay, EffectFade, Keyboard, A11y],
      effect: 'fade',
      fadeEffect: { crossFade: true },
      loop: true,
      slidesPerView: 1,
      spaceBetween: 0,
      speed: reduce ? 0 : 800,
      autoplay: reduce ? false : {
        delay: 7000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      keyboard: { enabled: true, onlyInViewport: true },
      a11y: {
        prevSlideMessage: 'Previous testimonial',
        nextSlideMessage: 'Next testimonial',
        paginationBulletMessage: 'Show testimonial {{index}} of 4',
      },
      navigation: {
        nextEl: section.querySelector('.t-next'),
        prevEl: section.querySelector('.t-prev'),
      },
      pagination: {
        el: section.querySelector('.t-pagination'),
        clickable: true,
        renderBullet: (_index, className) => {
          return `<span class="${className} t-bullet"><span class="t-bullet-fill" aria-hidden="true"></span></span>`;
        },
      },
      on: {
        init: (sw) => updateCounter(sw.realIndex),
        slideChange: (sw) => updateCounter(sw.realIndex),
        autoplayPause: (sw) => sw.el.classList.add('is-paused'),
        autoplayResume: (sw) => sw.el.classList.remove('is-paused'),
      },
    });

    if (!reduce && swiper.autoplay) {
      // Focus pause: stop autoplay and freeze progress bar when keyboard
      // users tab into a nav button or the carousel itself.
      swiperEl.addEventListener('focusin', () => {
        swiper.autoplay.stop();
        swiperEl.classList.add('is-paused');
      });
      swiperEl.addEventListener('focusout', () => {
        swiper.autoplay.start();
        swiperEl.classList.remove('is-paused');
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
