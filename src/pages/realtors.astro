---
import Layout from '../layouts/Layout.astro';
import RealtorsHero from '../components/realtors/Hero.astro';
import LogoMarquee from '../components/realtors/LogoMarquee.astro';
import PainPoints from '../components/realtors/PainPoints.astro';
import Services from '../components/realtors/Services.astro';
import ResultsCarousel from '../components/realtors/ResultsCarousel.astro';
import StatsCounters from '../components/realtors/StatsCounters.astro';
import Pricing from '../components/realtors/Pricing.astro';
import MarqueeStrip from '../components/realtors/MarqueeStrip.astro';
import Testimonials from '../components/realtors/Testimonials.astro';
import FAQ from '../components/realtors/FAQ.astro';
import FinalCTA from '../components/realtors/FinalCTA.astro';
import MobileFloatingCTA from '../components/realtors/MobileFloatingCTA.astro';
import en from '../translations/realtors/en.json';
import es from '../translations/realtors/es.json';

const brokerageLogos = Array.from({ length: 10 }, (_, i) => ({
  src: `/brokerages/placeholder-${i + 1}.svg`,
  alt: `Brokerage ${i + 1} logo`,
  name: `Brokerage ${i + 1}`,
}));

export const prerender = true;

const lang = 'en';
const dict = en;
const enB64 = Buffer.from(JSON.stringify(en)).toString('base64');
const esB64 = Buffer.from(JSON.stringify(es)).toString('base64');

// JSON-LD structured data for SEO rich snippets.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': dict.faq.items.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer,
    },
  })),
};

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  'name': 'Broker Lenders',
  'description': dict.metaDescription,
  'url': Astro.url.origin,
  'logo': `${Astro.url.origin}/logo.png`,
  'telephone': '+1-801-307-0273',
  'email': 'pedro@brokerlenders.com',
  'identifier': 'NMLS #318973',
  'provider': {
    '@type': 'Organization',
    'name': 'Xpert Home Lending',
    'identifier': 'NMLS #2179191',
  },
  'areaServed': [
    { '@type': 'State', 'name': 'Utah' },
    { '@type': 'State', 'name': 'Idaho' },
    { '@type': 'State', 'name': 'Nevada' },
    { '@type': 'State', 'name': 'California' },
    { '@type': 'State', 'name': 'Texas' },
    { '@type': 'State', 'name': 'Florida' },
    { '@type': 'State', 'name': 'Colorado' },
  ],
};
---

<Layout
  title={dict.title}
  lang={lang}
  description={dict.metaDescription}
  hreflangPath="/realtors"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(orgJsonLd)} slot="head" />
  <RealtorsHero />

  <LogoMarquee logos={brokerageLogos} />

  <PainPoints />

  <Services />

  <ResultsCarousel />

  <StatsCounters />

  <Pricing />

  <MarqueeStrip />

  <Testimonials />

  <FAQ />

  <FinalCTA />
</Layout>

<MobileFloatingCTA />

<div id="i18n-realtors" data-en={enB64} data-es={esB64} style="display:none"></div>

<script is:inline>
  (() => {
    const root = document.getElementById('i18n-realtors');
    const decode = (val) => {
      try {
        const b64 = val || '';
        const bin = atob(b64);
        const bytes = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        const jsonText = new TextDecoder('utf-8').decode(bytes);
        return JSON.parse(jsonText);
      } catch {
        return {};
      }
    };

    const translations = {
      en: decode(root?.getAttribute('data-en') || ''),
      es: decode(root?.getAttribute('data-es') || ''),
    };

    const getValue = (obj, path) => {
      return path.split('.').reduce((acc, key) => (acc && key in acc ? acc[key] : null), obj);
    };

    const getInitialLang = () => {
      const urlLang = new URLSearchParams(window.location.search).get('lang');
      const stored = localStorage.getItem('lang');
      const raw = (urlLang || stored || 'en').toLowerCase();
      return raw === 'es' ? 'es' : 'en';
    };

    const keepLangOnCtas = (lang) => {
      const ids = ['realtor-cta-demo', 'realtor-pricing-partner', 'realtor-pricing-professional', 'realtor-pricing-advanced', 'realtor-faq-cta', 'realtor-finalcta-book', 'realtor-prefooter-demo', 'realtor-prefooter-apply', 'realtor-mobile-cta-book'];
      ids.forEach((id) => {
        const link = document.getElementById(id);
        if (!link) return;
        try {
          const url = new URL(link.href, window.location.origin);
          if (url.origin === window.location.origin) {
            url.searchParams.set('lang', lang);
            link.href = `${url.pathname}${url.search}${url.hash}`;
          }
        } catch {}
      });
    };

    const apply = (lang) => {
      const dict = translations[lang] || translations.en;
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (!key) return;
        const value = getValue(dict, key);
        if (typeof value === 'string') el.textContent = value;
      });
      document.querySelectorAll('[data-i18n-alt]').forEach((el) => {
        const key = el.getAttribute('data-i18n-alt');
        if (!key) return;
        const value = getValue(dict, key);
        if (typeof value === 'string') el.setAttribute('alt', value);
      });
      document.querySelectorAll('[data-i18n-aria]').forEach((el) => {
        const key = el.getAttribute('data-i18n-aria');
        if (!key) return;
        const value = getValue(dict, key);
        if (typeof value === 'string') el.setAttribute('aria-label', value);
      });
      if (dict.title) document.title = dict.title;
      keepLangOnCtas(lang);
    };

    const setLanguage = (lang) => {
      const next = lang === 'es' ? 'es' : 'en';
      localStorage.setItem('lang', next);
      try { document.cookie = `lang=${next}; path=/; max-age=${60 * 60 * 24 * 365}; SameSite=Lax`; } catch {}
      const url = new URL(window.location.href);
      url.searchParams.set('lang', next);
      window.history.replaceState({}, '', url.toString());
      apply(next);
    };

    setLanguage(getInitialLang());

    document.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target.closest('a[href*="?lang="]') : null;
      if (!target) return;
      let href = null;
      try { href = new URL(target.href, window.location.origin); } catch { href = null; }
      const lang = href?.searchParams.get('lang');
      if (lang) apply(lang);
    });

    window.addEventListener('storage', (ev) => {
      if (ev.key === 'lang' && ev.newValue) apply(ev.newValue);
    });

    window.addEventListener('popstate', () => {
      apply(getInitialLang());
    });
  })();
</script>
