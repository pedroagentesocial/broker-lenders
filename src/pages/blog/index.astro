---
import Layout from '../../layouts/Layout.astro';
import BlogLegal from '../../components/blog/BlogLegal.astro';
import '../../styles/blog.css';
import { resolveLang, withLang } from '../../lib/lang';
import { getPublishedPosts, getUpcoming, formatDate } from '../../lib/blog';
import { ui } from '../../lib/blog-ui';

// SSR obligatorio: el filtro por fecha corre en cada request, así el artículo
// programado aparece solo cuando le toca, sin cron ni deploy.
export const prerender = false;

const lang = resolveLang(Astro.url, Astro.cookies);
const t = ui(lang);

const posts = await getPublishedPosts(lang);
const upcoming = await getUpcoming(lang, 2);
const [featured, ...rest] = posts;

const SITE_URL = 'https://brokerlenders.com';

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE_URL}/blog#blog`,
  url: `${SITE_URL}/blog`,
  name: t.indexMetaTitle,
  description: t.indexMetaDescription,
  inLanguage: lang === 'es' ? 'es-US' : 'en-US',
  publisher: { '@id': `${SITE_URL}/#organization` },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    '@id': `${SITE_URL}/blog/${p.slug}#post`,
    headline: p.entry.data.title,
    description: p.entry.data.description,
    datePublished: p.publishDate.toISOString(),
    url: `${SITE_URL}/blog/${p.slug}`,
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.breadcrumbHome, item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: t.breadcrumbBlog, item: `${SITE_URL}/blog` },
  ],
};
---

<Layout
  title={t.indexMetaTitle}
  description={t.indexMetaDescription}
  lang={lang}
  keywords="mortgage blog, home loan guides, down payment, closing costs, PMI, pre-approval, refinance, blog hipotecario, guías de préstamos"
  hreflangPath="/blog"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(blogJsonLd)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />

  <!-- Breadcrumb -->
  <div class="bg-white py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm" aria-label="Breadcrumb">
        <a href={withLang('/', lang)} class="text-gray-700 hover:text-red-600">{t.breadcrumbHome}</a>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-gray-500">{t.breadcrumbBlog}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-white pt-6 pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-red-600">
          <span class="w-6 h-0.5 bg-red-600" aria-hidden="true"></span>
          Broker Lenders
        </span>
        <h1 class="mt-4 text-4xl md:text-5xl font-bold text-gray-900 tracking-tight">{t.indexTitle}</h1>
        <p class="mt-5 text-lg text-gray-600">{t.indexSubtitle}</p>
      </div>
    </div>
  </section>

  {posts.length === 0 && (
    <section class="pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-gray-500">{t.emptyState}</p>
      </div>
    </section>
  )}

  <!-- Artículo destacado -->
  {featured && (
    <section class="pb-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <a
          href={withLang(`/blog/${featured.slug}`, lang)}
          class="group block rounded-[32px] border border-gray-200 bg-gray-50 p-8 lg:p-12 transition-colors hover:border-gray-900"
        >
          <div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-wide">
            <span class="rounded-full bg-black px-3 py-1 text-white">{featured.entry.data.category}</span>
            {featured.isNew && (
              <span class="rounded-full bg-red-600 px-3 py-1 text-white">{t.newBadge}</span>
            )}
            <span class="text-gray-500 normal-case tracking-normal font-normal">
              {formatDate(featured.publishDate, lang)} · {t.readTime(featured.entry.data.readingMinutes)}
            </span>
          </div>
          <h2 class="mt-5 text-3xl lg:text-4xl font-bold text-gray-900 tracking-tight group-hover:text-red-600 transition-colors">
            {featured.entry.data.title}
          </h2>
          <p class="mt-4 max-w-3xl text-lg text-gray-600">{featured.entry.data.description}</p>
          <span class="mt-6 inline-flex items-center gap-2 font-semibold text-gray-900 group-hover:text-red-600 transition-colors">
            {lang === 'es' ? 'Leer la guía' : 'Read the guide'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      </div>
    </section>
  )}

  <!-- Resto de artículos -->
  {rest.length > 0 && (
    <section class="pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {rest.map((post) => (
            <a
              href={withLang(`/blog/${post.slug}`, lang)}
              class="group flex flex-col rounded-3xl border border-gray-200 p-7 transition-colors hover:border-gray-900"
            >
              <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wide">
                <span class="rounded-full border border-gray-300 px-3 py-1 text-gray-700">{post.entry.data.category}</span>
                {post.isNew && <span class="rounded-full bg-red-600 px-3 py-1 text-white">{t.newBadge}</span>}
              </div>
              <h3 class="mt-4 text-xl font-bold text-gray-900 leading-snug group-hover:text-red-600 transition-colors">
                {post.entry.data.title}
              </h3>
              <p class="mt-3 text-sm text-gray-600 flex-1">{post.entry.data.description}</p>
              <p class="mt-5 text-xs text-gray-500">
                {formatDate(post.publishDate, lang)} · {t.readTime(post.entry.data.readingMinutes)}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Próximamente: hace visible el calendario editorial -->
  {upcoming.length > 0 && (
    <section class="pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-[32px] border border-dashed border-gray-300 p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="text-xl font-bold text-gray-900">{t.upcomingTitle}</h2>
            <p class="text-sm text-gray-500">{t.upcomingNote}</p>
          </div>
          <ul class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
            {upcoming.map((item) => (
              <li class="rounded-2xl bg-gray-50 px-5 py-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-red-600">
                  {formatDate(item.publishDate, lang)}
                </p>
                <p class="mt-1 font-semibold text-gray-900">{item.entry.data.title}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-black py-16 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold">{t.ctaTitle}</h2>
      <p class="mt-4 text-lg text-gray-300 max-w-2xl mx-auto">{t.ctaBody}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="https://pedrolira.my1003app.com/318973/register"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white text-black px-8 py-3 rounded-[48px] font-semibold hover:bg-red-600 hover:text-white transition-colors"
        >
          {t.ctaPrimary}
        </a>
        <a
          href="tel:8013070273"
          class="border border-white px-8 py-3 rounded-[48px] font-semibold hover:bg-white hover:text-black transition-colors"
        >
          {t.ctaSecondary}
        </a>
      </div>
    </div>
  </section>

  <BlogLegal lang={lang} />
</Layout>
