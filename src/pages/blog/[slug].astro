---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/blog.css';
import { resolveLang, withLang } from '../../lib/lang';
import { getPost, getRelated, formatDate } from '../../lib/blog';
import { ui } from '../../lib/blog-ui';

// SSR obligatorio: un artículo aún programado no debe existir todavía.
export const prerender = false;

const { slug } = Astro.params;
const lang = resolveLang(Astro.url, Astro.cookies);
const t = ui(lang);

const lookup = await getPost(slug!, lang);

// Slug real pero aún sin publicar → al índice, para no filtrar el calendario
// editorial ni dejar un 404 que Google recuerde.
if (lookup.status === 'scheduled') return Astro.redirect(withLang('/blog', lang), 302);

// Slug inexistente → 404 de verdad (no se puede hacer rewrite de una ruta SSR
// a la página /404 prerenderizada), así que lo renderizamos aquí mismo.
const post = lookup.status === 'published' ? lookup.post : null;
if (!post) Astro.response.status = 404;

const data = post?.entry.data;
const Content = post ? (await render(post.entry)).Content : null;
const related = post ? await getRelated(post.slug, lang, 3) : [];

const SITE_URL = 'https://brokerlenders.com';
const postUrl = post ? `${SITE_URL}/blog/${post.slug}` : `${SITE_URL}/blog`;

const articleJsonLd =
  post && data
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        '@id': `${postUrl}#post`,
        mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
        headline: data.title,
        description: data.description,
        url: postUrl,
        inLanguage: lang === 'es' ? 'es-US' : 'en-US',
        datePublished: post.publishDate.toISOString(),
        dateModified: (data.updatedDate ?? post.publishDate).toISOString(),
        articleSection: data.category,
        keywords: data.keywords,
        image: `${SITE_URL}/logo.png`,
        author: {
          '@type': 'Person',
          name: 'Pedro Lira',
          jobTitle: 'Loan Officer',
          identifier: 'NMLS #318973',
          url: `${SITE_URL}/aboutus`,
        },
        publisher: { '@id': `${SITE_URL}/#organization` },
        isPartOf: { '@id': `${SITE_URL}/blog#blog` },
        citation: data.sources.map((s) => ({ '@type': 'CreativeWork', name: s.label, url: s.url })),
      }
    : null;

const breadcrumbJsonLd =
  post && data
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: t.breadcrumbHome, item: `${SITE_URL}/` },
          { '@type': 'ListItem', position: 2, name: t.breadcrumbBlog, item: `${SITE_URL}/blog` },
          { '@type': 'ListItem', position: 3, name: data.title, item: postUrl },
        ],
      }
    : null;
---

<Layout
  title={data ? `${data.title} | Broker Lenders` : `${t.notFoundTitle} | Broker Lenders`}
  description={data?.description ?? t.notFoundBody}
  lang={lang}
  keywords={data?.keywords}
  hreflangPath={post ? `/blog/${post.slug}` : undefined}
  noindex={!post}
>
  {articleJsonLd && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} slot="head" />
  )}
  {breadcrumbJsonLd && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />
  )}

  <!-- Breadcrumb -->
  <div class="bg-white py-4">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm" aria-label="Breadcrumb">
        <a href={withLang('/', lang)} class="text-gray-700 hover:text-red-600">{t.breadcrumbHome}</a>
        <span class="mx-2 text-gray-400">/</span>
        <a href={withLang('/blog', lang)} class="text-gray-700 hover:text-red-600">{t.breadcrumbBlog}</a>
        {data && (
          <>
            <span class="mx-2 text-gray-400">/</span>
            <span class="text-gray-500">{data.category}</span>
          </>
        )}
      </nav>
    </div>
  </div>

  {!post && (
    <section class="py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-red-600">404</p>
        <h1 class="mt-4 text-4xl font-bold text-gray-900">{t.notFoundTitle}</h1>
        <p class="mt-4 text-lg text-gray-600">{t.notFoundBody}</p>
        <a
          href={withLang('/blog', lang)}
          class="mt-8 inline-block bg-black text-white px-8 py-3 rounded-[48px] font-semibold hover:bg-red-600 transition-colors"
        >
          {t.breadcrumbBlog}
        </a>
      </div>
    </section>
  )}

  {post && data && Content && (
    <article>
      <header class="bg-white pt-6 pb-10">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-wide">
            <span class="rounded-full bg-black px-3 py-1 text-white">{data.category}</span>
            {post.isNew && <span class="rounded-full bg-red-600 px-3 py-1 text-white">{t.newBadge}</span>}
          </div>
          <p class="mt-6 text-sm font-bold uppercase tracking-widest text-red-600">{data.kicker}</p>
          <h1 class="mt-3 text-4xl md:text-5xl font-bold text-gray-900 tracking-tight leading-tight">{data.title}</h1>
          <p class="mt-5 text-lg text-gray-600">{data.description}</p>
          <p class="mt-6 text-sm text-gray-500">
            <span class="font-semibold text-gray-900">Pedro Lira</span> · NMLS #318973 ·
            <time datetime={post.publishDate.toISOString()}>{formatDate(post.publishDate, lang)}</time>
            {data.updatedDate && (
              <>
                {' · '}{t.updatedOn}{' '}
                <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate, lang)}</time>
              </>
            )}
            {' · '}{t.readTime(data.readingMinutes)}
          </p>
        </div>
      </header>

      <div class="pb-16">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="bl-prose">
            <Content />
          </div>
        </div>
      </div>
    </article>
  )}

  <!-- Fuentes: regla editorial del blog -->
  {data && (
    <section class="pb-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-gray-200 p-7">
          <h2 class="text-sm font-bold uppercase tracking-widest text-gray-900">{t.sourcesTitle}</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {data.sources.map((source) => (
              <li>
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="text-gray-700 underline decoration-red-600 decoration-2 underline-offset-4 hover:text-red-600"
                >
                  {source.label}
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-5 text-xs text-gray-500 leading-relaxed">{t.sourcesNote}</p>
        </div>
      </div>
    </section>
  )}

  <!-- Autor -->
  {post && (
    <section class="pb-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl bg-gray-50 p-7 sm:flex sm:items-start sm:gap-6">
          <div class="flex-none w-16 h-16 rounded-full bg-black text-white flex items-center justify-center text-xl font-bold">
            PL
          </div>
          <div class="mt-4 sm:mt-0">
            <p class="font-bold text-gray-900">{t.authorName}</p>
            <p class="text-sm text-red-600 font-semibold">{t.authorRole}</p>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">{t.authorBio}</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Relacionados -->
  {related.length > 0 && (
    <section class="pb-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-gray-900">{t.relatedTitle}</h2>
        <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {related.map((item) => (
            <a
              href={withLang(`/blog/${item.slug}`, lang)}
              class="group rounded-2xl border border-gray-200 p-5 transition-colors hover:border-gray-900"
            >
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">{item.entry.data.category}</p>
              <p class="mt-2 font-semibold text-gray-900 leading-snug group-hover:text-red-600 transition-colors">
                {item.entry.data.title}
              </p>
            </a>
          ))}
        </div>
        <p class="mt-6">
          <a href={withLang('/blog', lang)} class="text-sm font-semibold text-gray-700 hover:text-red-600">
            {t.backToBlog}
          </a>
        </p>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-black py-16 text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold">{t.ctaTitle}</h2>
      <p class="mt-4 text-lg text-gray-300">{t.ctaBody}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="https://pedrolira.my1003app.com/318973/register"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white text-black px-8 py-3 rounded-[48px] font-semibold hover:bg-red-600 hover:text-white transition-colors"
        >
          {t.ctaPrimary}
        </a>
        <a
          href="tel:8013070273"
          class="border border-white px-8 py-3 rounded-[48px] font-semibold hover:bg-white hover:text-black transition-colors"
        >
          {t.ctaSecondary}
        </a>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-8">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs text-gray-500 leading-relaxed">{t.disclaimer}</p>
    </div>
  </section>
</Layout>
