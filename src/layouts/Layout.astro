---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
	title: string;
  lang?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonical?: string;
  hreflangPath?: string;
  noindex?: boolean;
}

const {
  title,
  lang = 'en',
  description = 'Broker Lenders - Home loans made for your lifestyle. Get competitive mortgage rates, FHA, VA, conventional and jumbo loans across UT, ID, NV, CA, TX, FL and CO.',
  keywords,
  ogImage = '/logo.png',
  canonical,
  hreflangPath,
  noindex = false,
} = Astro.props;

// Production site URL (configured in astro.config.mjs)
const SITE_URL = 'https://brokerlenders.com';
const origin = Astro.site?.origin || SITE_URL;

// Build canonical without tracking/lang params to avoid duplicate-content
const cleanPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const currentUrl = canonical || `${origin}${cleanPath === '/' ? '/' : cleanPath + '/'}`;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${origin}${ogImage}`;

// Global Organization JSON-LD (rendered once, helps Knowledge Panel + brand SERP)
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  '@id': `${SITE_URL}/#organization`,
  name: 'Broker Lenders',
  alternateName: 'Broker Lenders by Pedro Lira',
  url: SITE_URL,
  logo: `${SITE_URL}/logo.png`,
  image: `${SITE_URL}/logo.png`,
  description,
  telephone: '+1-801-307-0273',
  email: 'pedro@brokerlenders.com',
  identifier: 'NMLS #318973',
  priceRange: '$$',
  areaServed: [
    { '@type': 'State', name: 'Utah' },
    { '@type': 'State', name: 'Idaho' },
    { '@type': 'State', name: 'Nevada' },
    { '@type': 'State', name: 'California' },
    { '@type': 'State', name: 'Texas' },
    { '@type': 'State', name: 'Florida' },
    { '@type': 'State', name: 'Colorado' },
  ],
  sameAs: [
    'https://www.facebook.com/brokerlenders',
    'https://www.instagram.com/brokerlenders',
    'https://www.linkedin.com/company/broker-lenders',
  ],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: 'Broker Lenders',
  description,
  inLanguage: ['en-US', 'es-US'],
  publisher: { '@id': `${SITE_URL}/#organization` },
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
		<meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		<meta name="theme-color" content="#000000" />
		<meta name="format-detection" content="telephone=yes" />
		<meta name="author" content="Broker Lenders" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={currentUrl} />

		<!-- Performance: preconnect to third-party origins -->
		<link rel="preconnect" href="https://www.google.com" crossorigin />
		<link rel="dns-prefetch" href="https://www.google.com" />

		<meta property="og:site_name" content="Broker Lenders" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:url" content={currentUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
		<meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_US'} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageAbsolute} />
		<meta name="twitter:image:alt" content={title} />

		{hreflangPath && (
			<>
				<link rel="alternate" hreflang="en-US" href={`${origin}${hreflangPath}`} />
				<link rel="alternate" hreflang="es-US" href={`${origin}${hreflangPath}?lang=es`} />
				<link rel="alternate" hreflang="x-default" href={`${origin}${hreflangPath}`} />
			</>
		)}

		<!-- Global structured data -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)} />

		<slot name="head" />
    <!-- Early i18n sync: persist SSR lang to localStorage/cookie and URL -->
    <script is:inline>
      (() => {
        try {
          const url = new URL(window.location.href);
          const urlLang = (url.searchParams.get('lang') || '').toLowerCase();
          const ssrLang = (document.documentElement.getAttribute('lang') || 'en').toLowerCase();
          const initial = (urlLang === 'es' || urlLang === 'en') ? urlLang : ssrLang;
          // Reflect chosen lang in <html>
          try { document.documentElement.setAttribute('lang', initial); } catch {}
          // Persist to localStorage & cookie
          try { localStorage.setItem('lang', initial); } catch {}
          try { document.cookie = `lang=${initial};path=/;max-age=31536000;SameSite=Lax`; } catch {}
          // Ensure URL keeps the chosen language without reload
          try {
            const current = (url.searchParams.get('lang') || '').toLowerCase();
            if (current !== initial) {
              url.searchParams.set('lang', initial);
              window.history.replaceState({}, '', url.toString());
            }
          } catch {}
        } catch (e) {
          console.warn('[i18n][layout] early sync failed', e);
        }
      })();
    </script>
	</head>
	<body class="bg-white text-gray-900 font-sans">
		<Header lang={lang} />
		<main>
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style>
	html {
		font-family: system-ui, sans-serif;
	}
</style>